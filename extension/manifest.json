{
  "manifest_version": 3,
  "name": "Gửi bài thi sang Exam Viewer",
  "version": "1.2.0",
  "description": "Thêm nút trên trang review của cloudexam.pro để gửi kết quả bài thi sang Exam Viewer.",
  "permissions": ["storage"],
  "host_permissions": ["https://xuan-giang.github.io/exam-viewer/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://cloudexam.pro/*"], "js": ["cloudexam.js"] },
    { "matches": ["https://xuan-giang.github.io/exam-viewer/*"], "js": ["viewer.js"] }
  ]
}
